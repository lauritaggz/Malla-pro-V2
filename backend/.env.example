# Copia a backend/.env y ajusta. Nunca subas .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://mallapro:change-me@localhost:5432/mallapro
TEST_DATABASE_URL=postgresql+asyncpg://mallapro:change-me@localhost:5432/mallapro_test
# Separados por coma (el dev server del frontend corre en 5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Firebase Admin. Local: ruta al service account (ignorado por git, no lo subas).
FIREBASE_CREDENTIALS_PATH=firebase-sa.json
# Producción: el mismo JSON en base64 (tiene prioridad sobre la ruta).
# FIREBASE_CREDENTIALS_JSON=
# Prototipo de IA (rama spike/ia-mallas). La clave va solo aquí, nunca en git ni en el chat.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
