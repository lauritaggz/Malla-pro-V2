# Copia a .env.local (ignorado por git) y completa con la config web de tu proyecto Firebase.
# Sin estas variables la app funciona igual, sin login.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# URL del backend. Si está vacía o la API no responde, el catálogo sale de public/mallas/*.json.
VITE_API_URL=http://localhost:8000
